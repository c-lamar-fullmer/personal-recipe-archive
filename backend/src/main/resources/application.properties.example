# ===============================================================
# DATABASE CONNECTION
# ===============================================================

# The PostgreSQL database must already exist before Spring Boot
# can connect to it.
#
# Create it in psql or pgAdmin with:
# CREATE DATABASE recipe_archive;

# Copy this file to "application.properties" in the same folder.
# Then replace the YOUR_DB_USERNAME and YOUR_DB_PASSWORD
# placeholders with your local PostgreSQL credentials.
#
# application.properties is listed in .gitignore, so your real
# database credentials will NOT be committed to GitHub.

# JDBC = Java Database Connectivity.
# This tells Spring Boot to connect to PostgreSQL running locally
# on port 5432 and use the "recipe_archive" database.
spring.datasource.url=jdbc:postgresql://localhost:5432/recipe_archive

# PostgreSQL username used to connect to the database.
# Replace this placeholder with your own PostgreSQL username.
spring.datasource.username=YOUR_DB_USERNAME

# PostgreSQL password for the username above.
# Replace this placeholder with your own PostgreSQL password.
spring.datasource.password=YOUR_DB_PASSWORD

# Tells Spring Boot which JDBC driver to use for PostgreSQL.
spring.datasource.driver-class-name=org.postgresql.Driver


# ===============================================================
# JPA / HIBERNATE
# ===============================================================

# JPA (Java Persistence API) allows Java classes to be mapped
# to database tables.
#
# Hibernate is the JPA implementation used by Spring Boot.
#
# "update" tells Hibernate to automatically create or update
# database tables based on your @Entity classes when the
# application starts.
#
# This is convenient during development and learning.
# In a larger production project, database changes are usually
# managed with a migration tool such as Flyway.
spring.jpa.hibernate.ddl-auto=update

# Tells Hibernate that PostgreSQL is the database being used.
# Hibernate can then generate SQL appropriate for PostgreSQL.
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Prints the SQL statements Hibernate sends to PostgreSQL
# in the Spring Boot console.
#
# This is useful for learning and debugging because you can
# see the SQL generated by your Java code.
spring.jpa.show-sql=true

# Formats Hibernate's SQL output so that longer SQL statements
# are easier to read in the console.
spring.jpa.properties.hibernate.format_sql=true


# ===============================================================
# SERVER
# ===============================================================

# Tells Spring Boot which port its built-in web server should use.
#
# With port 8080, your backend can be accessed at:
# http://localhost:8080
server.port=8080


# ===============================================================
# ADMIN PROTECTION
# ===============================================================

# Password used by the simple Phase 1 admin authentication check.
#
# After copying this file to application.properties, replace
# YOUR_ADMIN_PASSWORD with the password you want to use.
#
# The frontend sends this password in an "X-Admin-Password"
# HTTP header when making POST, PUT, or DELETE requests.
#
# The backend checks the password before allowing those
# operations.
admin.password=YOUR_ADMIN_PASSWORD